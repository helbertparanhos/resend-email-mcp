# ─── Required ───────────────────────────────────────────────────────────────
# Your Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional defaults ──────────────────────────────────────────────────────
# Default "from" address used when send_email omits `from`.
# Must be a verified domain (e.g. "Acme <hello@acme.com>") or "onboarding@resend.dev" for testing.
RESEND_FROM=

# Default reply-to address (single email) used when a send omits `replyTo`.
RESEND_REPLY_TO=

# ─── Safety ─────────────────────────────────────────────────────────────────
# When "true", every mutating tool (send, create, update, delete, verify...) is blocked.
# Read/list/get/debug tools still work. Great for safe exploration of a production account.
RESEND_READONLY=false

# ─── Attachments from disk (opt-in) ─────────────────────────────────────────
# To allow send_email to attach files via `localPath`, set this to a directory.
# Only files INSIDE this directory can be read (path traversal is blocked).
# Leave empty to disable disk reads entirely (safer default).
RESEND_ATTACHMENTS_DIR=

# ─── Advanced ───────────────────────────────────────────────────────────────
# Override the API base URL (rarely needed). Must be https (http only for localhost).
RESEND_BASE_URL=https://api.resend.com

# Max automatic retries on 429/5xx responses (default 3).
RESEND_MAX_RETRIES=3
